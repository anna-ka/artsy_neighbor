<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="ArtsyNeighbor" suffix=" · Phoenix Framework">
      {assigns[:page_title]}
    </.live_title>
    <link rel="icon" type="image/x-icon" href={~p"/images/favicon.ico"} />
    <%!-- Sentient and Switzer, from Fontshare's font service (see Phase A in
         docs/plans/2026-10-15-theme-and-components.md). Careful when changing
         the weight list: Fontshare quietly returns a different font for some
         lists, so check the result (e.g. with curl -g). --%>
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=sentient@300,301,400,401,500,600,700&f[]=switzer@400,500,600,700&display=swap"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <%!-- Development only, until Phase D: the message trial (see
         Layouts.flash_group/1). Remembers the look (of warnings and errors)
         and place (of all messages) chosen with the switches on
         /dev/styleguide, and puts them on the page as data-msg-look /
         data-msg-place, which assets/css/app.css acts on. The choice lives in this browser only. --%>
    <script :if={dev_routes?()}>
      (function () {
        var defaults = { "msg-look": "tinted", "msg-place": "top" };

        function chosen(key) {
          try {
            return localStorage.getItem(key) || defaults[key];
          } catch (error) {
            return defaults[key];
          }
        }

        // Puts the choices on the page, and ticks the matching switches.
        function apply() {
          Object.keys(defaults).forEach(function (key) {
            var value = chosen(key);
            document.documentElement.setAttribute("data-" + key, value);
            document.querySelectorAll('input[name="' + key + '"]').forEach(function (input) {
              input.checked = input.value === value;
            });
          });
        }

        // A switch was changed: remember it, then apply.
        document.addEventListener("change", function (event) {
          var key = event.target.name;
          if (!defaults.hasOwnProperty(key)) return;
          try {
            localStorage.setItem(key, event.target.value);
          } catch (error) {}
          apply();
        });

        apply();
        // Again once LiveView has drawn a page, so the switches show the choice.
        window.addEventListener("phx:page-loading-stop", apply);
      })();
    </script>
  </head>
  <body>
    <ul class="menu menu-horizontal w-full relative z-10 flex items-center gap-4 px-4 sm:px-6 lg:px-8 justify-end">
      <%= if @current_scope do %>
        <li>
          {@current_scope.user.username}
        </li>
        <li>
          <.link href={~p"/users/settings"}>Settings</.link>
        </li>
        <li>
          <.link href={~p"/users/log-out"} method="delete">Log out</.link>
        </li>
        <%= if @current_scope.artist do %>
          <li>
            <.link navigate={~p"/vendor"}>Vendor Dashboard</.link>
          </li>
        <% end %>
        <%= if @current_scope.admin do %>
          <li>
            <.link navigate={~p"/admin"}>Admin Dashboard</.link>
          </li>
        <% end %>
      <% else %>
        <li>
          <.link href={~p"/users/register"}>Register</.link>
        </li>
        <li>
          <.link href={~p"/users/log-in"}>Log in</.link>
        </li>
      <% end %>
    </ul>
    {@inner_content}
  </body>
</html>
